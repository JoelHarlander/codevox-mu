{
  "$note": "Mirrors CodeVox's design system. Copied here so CodeVox mU follows the same colours, chamfer, radius, and type.",
  "$schema_comment": "Industrial HUD design tokens — single source of truth. Schema: color.{name}={hex,alpha}; scalar.glow; chamfer.{sm,md,lg}; radius.{sm,md} (legacy soft containers); type.{heading,body,mono}={family,fallbacks[],postscript{weight:name}}. Consumed by design/system/generate.sh → Tauri CSS + Swift DesignTokens.",
  "color": {
    "accent": { "hex": "#FF6A00", "alpha": 1.0 },
    "accentDim": { "hex": "#FF6A00", "alpha": 0.5 },
    "background": { "hex": "#060606", "alpha": 1.0 },
    "panel": { "hex": "#0A0A0A", "alpha": 1.0 },
    "darkLight": { "hex": "#111111", "alpha": 1.0 },
    "darkLighter": { "hex": "#1A1A1A", "alpha": 1.0 },
    "textPrimary": { "hex": "#FAFAFA", "alpha": 1.0 },
    "textSecondary": { "hex": "#FAFAFA", "alpha": 0.55 },
    "textTertiary": { "hex": "#FAFAFA", "alpha": 0.4 },
    "destructive": { "hex": "#FF5A5A", "alpha": 1.0 },
    "warning": { "hex": "#FB923C", "alpha": 1.0 },
    "hairline": { "hex": "#FFFFFF", "alpha": 0.09 },
    "onAccent": { "hex": "#0A0A0A", "alpha": 1.0 }
  },
  "scalar": {
    "glow": 0
  },
  "chamfer": {
    "sm": 3,
    "md": 4,
    "lg": 7
  },
  "radius": {
    "sm": 6,
    "md": 8
  },
  "type": {
    "heading": {
      "family": "Space Mono",
      "fallbacks": ["ui-monospace", "monospace"],
      "postscript": {
        "regular": "SpaceMono-Regular",
        "bold": "SpaceMono-Bold"
      }
    },
    "body": {
      "family": "IBM Plex Mono",
      "fallbacks": ["ui-monospace", "monospace"],
      "postscript": {
        "regular": "IBMPlexMono-Regular",
        "medium": "IBMPlexMono-Medium"
      }
    },
    "mono": {
      "family": "IBM Plex Mono",
      "fallbacks": ["ui-monospace", "monospace"],
      "postscript": {
        "regular": "IBMPlexMono-Regular",
        "medium": "IBMPlexMono-Medium"
      }
    }
  }
}
